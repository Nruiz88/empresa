<%- include('partials/head') %>
<%- include('partials/header', { current: "inicio" }) %>

<main>
    <!-- ================= HERO =================
         Nota: nombres de clientes, métricas y datos de contacto son de ejemplo.
         Sustituye el bloque .hero-showcase por capturas reales cuando las tengas. -->
    <section class="hero" id="hero">
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid"></div>
        <span class="aurora aurora-1"></span>
        <span class="aurora aurora-2"></span>
        <span class="aurora aurora-3"></span>
        <div class="hero-noise"></div>
      </div>

      <div class="container">
        <div class="hero-layout">
          <!-- ---------- Columna de texto ---------- -->
          <div class="hero-copy">
            <span class="eyebrow eyebrow-pill">
              <span class="dot" aria-hidden="true"></span>
              Estudio digital · Webs, apps y e-commerce
            </span>

            <h1 class="hero-title">
              <span class="line"><span>Webs y aplicaciones</span></span>
              <span class="line"><span>que <em class="gradient-text">hacen crecer</em></span></span>
              <span class="line"><span>tu negocio</span></span>
            </h1>

            <p class="lead">
              Diseñamos y desarrollamos sitios web, tiendas online, web apps y aplicaciones
              a medida para empresas y comercios que quieren <strong>resultados</strong>,
              no solo una web bonita.
            </p>

            <div class="hero-actions">
              <a href="/contacto" class="btn btn-primary btn-lg magnetic">
                Pedir presupuesto gratis
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a href="/proyectos" class="btn btn-ghost btn-lg magnetic">Ver proyectos</a>
            </div>

            <!-- Prueba social inmediata bajo los CTA -->

            <!-- TODO(contenido): los avatares de abajo están
                 hardcodeados y duplican lo que ya hay en
                 content/stats.js (heroProof.avatars y overflowLabel).
                 Cuando se limpien los datos inventados, leerlos de
                 content/ como el resto. Ver PENDIENTES.md. -->
            <div class="hero-proof">
              <div class="avatar-stack" aria-hidden="true">
                <span class="avatar avatar-1">LM</span>
                <span class="avatar avatar-2">RO</span>
                <span class="avatar avatar-3">CV</span>
                <span class="avatar avatar-4">+80</span>
              </div>
              <div class="hero-proof-text">
                <span class="stars" role="img" aria-label="Valoración media 4,9 de 5 sobre 5">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </span>
                <p><strong><%= figures.heroProof.rating %></strong> · <%= figures.heroProof.claim %></p>
              </div>
            </div>

            <p class="hero-note"><span class="dot"></span> <%= figures.disponibilidad %></p>
          </div>

          <!-- ---------- Mockup de producto ---------- -->
          <div class="hero-showcase" data-tilt>
            <div class="mock-window">
              <div class="mock-bar">
                <span class="mock-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="mock-url">nexo.studio / panel</span>
                <span class="mock-pill">En vivo</span>
              </div>

              <div class="mock-body">
                <aside class="mock-side" aria-hidden="true">
                  <span class="mock-logo"></span>
                  <span class="mock-nav is-active"></span>
                  <span class="mock-nav"></span>
                  <span class="mock-nav"></span>
                  <span class="mock-nav"></span>
                  <span class="mock-nav"></span>
                </aside>

                <div class="mock-main">
                  <div class="mock-head">
                    <div>
                      <span class="mock-kicker">Rendimiento</span>
                      <strong>Resumen del mes</strong>
                    </div>
                    <span class="mock-chip">Últimos 30 días</span>
                  </div>

                  <div class="mock-kpis">
                    <div class="mock-kpi">
                      <span>Conversiones</span>
                      <strong>1.284</strong>
                      <em class="up">↑ 18,2 %</em>
                    </div>
                    <div class="mock-kpi">
                      <span>Velocidad</span>
                      <strong>98</strong>
                      <em class="up">↑ 6 pts</em>
                    </div>
                    <div class="mock-kpi">
                      <span>Tráfico</span>
                      <strong>24,8k</strong>
                      <em class="down">↓ 3,1 %</em>
                    </div>
                  </div>

                  <div class="mock-chart" aria-hidden="true">
                    <span style="--h:38%"></span><span style="--h:52%"></span><span style="--h:44%"></span>
                    <span style="--h:66%"></span><span style="--h:58%"></span><span style="--h:78%"></span>
                    <span style="--h:62%"></span><span style="--h:88%"></span><span style="--h:74%"></span>
                    <span style="--h:96%"></span><span style="--h:83%"></span><span style="--h:100%"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tarjetas flotantes -->
            <div class="float-card float-card--a" data-float="1">
              <span class="float-icon float-icon--up" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 7-7"/><path d="M14 8h7v7"/></svg>
              </span>
              <div>
                <strong>+40 %</strong>
                <span>conversiones en 3 meses</span>
              </div>
            </div>

            <div class="float-card float-card--b" data-float="2">
              <span class="float-icon float-icon--ok" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <div>
                <strong>Nuevo lead</strong>
                <span>Ticket #2481 · hace 2 min</span>
              </div>
            </div>

            <span class="orbit orbit--1" aria-hidden="true"></span>
            <span class="orbit orbit--2" aria-hidden="true"></span>
          </div>
        </div>

        <!-- ---------- Métricas ---------- -->
        <div class="stats reveal">
          <% figures.stats.forEach(function (s) { %>
            <div class="stat">
              <strong
                data-count="<%= s.count %>"
                <% if (s.prefix) { %>data-prefix="<%= s.prefix %>"<% } %>
                <% if (s.suffix) { %>data-suffix="<%= s.suffix %>"<% } %>
                <% if (s.decimals) { %>data-decimals="<%= s.decimals %>"<% } %>>
                <%= s.prefix || "" %><%= s.count %><%= s.suffix || "" %>
              </strong>
              <span><%= s.label %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Indicador de scroll -->
      <a href="#servicios" class="scroll-hint" aria-label="Ir a la sección de servicios">
        <span class="scroll-hint-text">Descubre</span>
        <span class="scroll-hint-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- MARCAS: se eliminó este bloque.
     La prueba social ya vive en el hero (avatares + 4,9/5 + nº de
     proyectos) y volver a listar los mismos nombres aquí solo ocupaba
     espacio sin aportar confianza nueva. Si algún día hay logotipos
     reales con permiso, este es el sitio natural para mostrarlos. -->

    <!-- ================= MARQUEE ================= -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Diseño web</span><span>Tiendas online</span><span>Web apps</span><span>Aplicaciones a medida</span><span>SEO local</span><span>Reservas online</span><span>Paneles de gestión</span><span>Integraciones con ERP</span><span>Mantenimiento y soporte</span>
        <span>Diseño web</span><span>Tiendas online</span><span>Web apps</span><span>Aplicaciones a medida</span><span>SEO local</span><span>Reservas online</span><span>Paneles de gestión</span><span>Integraciones con ERP</span><span>Mantenimiento y soporte</span>
      </div>
    </div>

    <!-- ================= SERVICIOS ================= -->
    <section class="section section--soft" id="servicios">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Servicios</span>
          <h2>Todo lo que tu negocio necesita para <span class="gradient-text">existir online</span></h2>
          <p>Desde la primera web de tu comercio hasta una plataforma completa con reservas, pagos y panel de gestión.</p>
        </div>

        <div class="grid grid-3">
          <article class="card reveal">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </div>
            <h3>Diseño y desarrollo web</h3>
            <p>Sitios corporativos rápidos, modernos y optimizados para posicionar en Google y convertir visitas en clientes.</p>
            <ul class="card-list">
              <li>Diseño a medida y responsive</li>
              <li>SEO técnico incluido</li>
              <li>CMS para autogestionar contenidos</li>
            </ul>
          </article>

          <article class="card reveal">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2 3h2l2.6 12.4a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21 7H6"/></svg>
            </div>
            <h3>Tiendas online</h3>
            <p>E-commerce con catálogo, pasarela de pago, envíos y facturación listos para vender desde el primer día.</p>
            <ul class="card-list">
              <li>Shopify o solución a medida</li>
              <li>Integración con ERP y albaranes</li>
              <li>Recuperación de carritos</li>
            </ul>
          </article>

          <article class="card reveal">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3>Web apps</h3>
            <p>Aplicaciones web robustas: portales de clientes, herramientas internas, paneles de control y SaaS.</p>
            <ul class="card-list">
              <li>Arquitectura escalable y segura</li>
              <li>Roles, permisos y auditoría</li>
              <li>Integraciones con APIs</li>
            </ul>
          </article>

          <article class="card reveal">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
            </div>
            <h3>Aplicaciones a medida</h3>
            <p>Apps para empresa y comercios: reservas, pedidos, gestión de stock, fidelización y más, en web y móvil.</p>
            <ul class="card-list">
              <li>iOS, Android y web</li>
              <li>PWA de bajo coste</li>
              <li>Panel de administración</li>
            </ul>
          </article>

          <article class="card reveal">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <h3>SEO y rendimiento</h3>
            <p>Auditamos, corregimos y aceleramos tu web para que cargue en menos de 2 segundos y suba en los resultados.</p>
            <ul class="card-list">
              <li>Auditoría técnica completa</li>
              <li>Core Web Vitals</li>
              <li>SEO local para comercios</li>
            </ul>
          </article>

          <article class="card reveal">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            </div>
            <h3>Mantenimiento e integraciones</h3>
            <p>Nos ocupamos de actualizaciones, copias de seguridad, incidencias y conectar tu web con las herramientas que ya usas.</p>
            <ul class="card-list">
              <li>Soporte mensual con SLA</li>
              <li>Copias y monitorización 24/7</li>
              <li>Automatizaciones a medida</li>
            </ul>
          </article>
        </div>

        <div style="text-align:center; margin-top: 2.5rem;" class="reveal">
          <a href="/servicios" class="btn btn-ghost">Ver todos los servicios en detalle →</a>
        </div>
      </div>
    </section>

    <!-- ================= AUTOMATIZACIÓN =================
         Sección aparte y no una tarjeta más de servicios: la
         automatización no es "diseño web", es otra categoría
         (integración con APIs de terceros) y mezclarla diluiría
         las dos. -->
    <%- include('partials/automation') %>

    <!-- ================= PROYECTOS ================= -->
    <section class="section" id="proyectos">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Proyectos</span>
          <h2>Resultados que puedes <span class="gradient-text">medir</span></h2>
          <p>No enseñamos pantallas bonitas: enseñamos lo que pasó después de lanzar. Una selección de webs, tiendas y aplicaciones con métricas reales.</p>
          <ul class="result-pills">
            <% figures.resultPills.forEach(function (pill) { %>
              <li><%= pill %></li>
            <% }); %>
          </ul>
        </div>

        <div class="grid grid-3">
          <% projects.slice(0, 6).forEach(function (p) { %>
            <article class="project-card reveal">
              <div class="project-thumb thumb-<%= p.thumb %>"><span class="thumb-art"><%= p.initials %></span></div>
              <div class="project-body">
                <div class="project-tags">
                  <% p.tags.forEach(function (t) { %><span class="tag"><%= t %></span><% }); %>
                </div>
                <h3><%= p.name %></h3>
                <p><%= p.summaryShort || p.summary %></p>
                <div class="project-result">↑ <%= p.result %></div>
              </div>
            </article>
          <% }) %>
        </div>

        <div style="text-align:center; margin-top: 2.5rem;" class="reveal">
          <a href="/proyectos" class="btn btn-ghost">Explorar todos los proyectos →</a>
        </div>
      </div>
    </section>

    <!-- ================= PROCESO ================= -->
    <!-- Versión compacta: antes ocupaba un bloque alto con un párrafo por
         fase. Ahora es una franja con las 4 fases en una línea, que se lee
         de un vistazo y deja respirar a las secciones de conversión. -->
    <section class="section section--soft section--slim">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Cómo trabajamos</span>
          <h2>Un proceso claro, sin sorpresas</h2>
        </div>

        <ol class="process-strip reveal">
          <li>
            <span class="process-num">01</span>
            <h3>Descubrimiento</h3>
            <p>Alcance, plazos y presupuesto cerrado.</p>
          </li>
          <li>
            <span class="process-num">02</span>
            <h3>Diseño</h3>
            <p>Validas el diseño antes de una línea de código.</p>
          </li>
          <li>
            <span class="process-num">03</span>
            <h3>Desarrollo</h3>
            <p>Entregas quincenales con entorno de pruebas.</p>
          </li>
          <li>
            <span class="process-num">04</span>
            <h3>Lanzamiento</h3>
            <p>Publicamos, medimos y damos soporte.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ================= PRECIOS ================= -->
    <section class="section" id="precios">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Precios</span>
          <h2>Planes transparentes, sin letra pequeña</h2>
          <p>Precio cerrado por proyecto. Sabes lo que pagas desde el primer día y qué recibes a cambio.</p>
        </div>

        <div class="price-grid">
          <div class="price-card reveal">
            <h3>Esencial</h3>
            <p class="plan-desc">Para comercios y profesionales que necesitan una presencia online sólida.</p>
            <div class="price"><span class="currency">desde</span><span class="amount">890</span><span class="currency">€</span></div>
            <p class="price-note">Pago único · Entrega en 2–3 semanas</p>
            <ul class="price-features">
              <li>Web de hasta 5 páginas</li>
              <li>Diseño responsive a medida</li>
              <li>Formulario de contacto y Google Maps</li>
              <li>SEO técnico básico</li>
              <li>Hosting y dominio el primer año</li>
              <li class="muted">Tienda online</li>
              <li class="muted">Aplicación a medida</li>
            </ul>
            <a href="/contacto" class="btn btn-ghost btn-block">Solicitar presupuesto</a>
          </div>

          <div class="price-card featured reveal">
            <span class="badge">Más elegido</span>
            <h3>Negocio</h3>
            <p class="plan-desc">Para empresas que quieren captar clientes y vender online de forma seria.</p>
            <div class="price"><span class="currency">desde</span><span class="amount">1.990</span><span class="currency">€</span></div>
            <p class="price-note">Pago único · Entrega en 4–6 semanas</p>
            <ul class="price-features">
              <li>Web de hasta 12 páginas + blog</li>
              <li>Tienda online o reservas online</li>
              <li>Textos y SEO on-page incluidos</li>
              <li>Analítica y objetivos configurados</li>
              <li>Integraciones (CRM, email, pagos)</li>
              <li>3 meses de soporte incluido</li>
              <li class="muted">Aplicación a medida</li>
            </ul>
            <a href="/contacto" class="btn btn-primary btn-block">Solicitar presupuesto</a>
          </div>

          <div class="price-card reveal">
            <h3>A medida</h3>
            <p class="plan-desc">Web apps, aplicativos y plataformas con lógica de negocio compleja.</p>
            <div class="price"><span class="currency">desde</span><span class="amount">4.500</span><span class="currency">€</span></div>
            <p class="price-note">Presupuesto por fases · 8–14 semanas</p>
            <ul class="price-features">
              <li>Arquitectura y diseño de producto</li>
              <li>Usuarios, roles y paneles privados</li>
              <li>API e integraciones con tu ERP</li>
              <li>App móvil o PWA</li>
              <li>Pruebas automatizadas y despliegue</li>
              <li>SLA de soporte y evolución</li>
              <li>Equipo dedicado</li>
            </ul>
            <a href="/contacto" class="btn btn-ghost btn-block">Hablemos del proyecto</a>
          </div>
        </div>

        <div style="text-align:center; margin-top: 2.5rem;" class="reveal">
          <a href="/precios" class="btn btn-ghost">Ver comparativa completa y FAQ →</a>
        </div>
      </div>
    </section>

    <!-- ================= TESTIMONIOS ================= -->
    <section class="section section--soft">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Testimonios</span>
          <h2>Lo que dicen nuestros clientes</h2>
        </div>

        <div class="grid grid-3">
          <% testimonials.forEach(function (t) { %>
            <figure class="quote reveal">
              <blockquote><%= t.quote %></blockquote>
              <figcaption class="quote-person">
                <span class="avatar avatar-<%= t.avatar %>" aria-hidden="true"><%= t.initials %></span>
                <div>
                  <strong><%= t.name %></strong>
                  <span><%= t.role %></span>
                </div>
              </figcaption>
            </figure>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ================= BLOG ================= -->
    <!-- Versión compacta: antes eran 3 tarjetas completas + botón, un pliegue
         entero que no convertía en la home. Ahora solo enlaza al blog, que es
         donde el contenido sí encuentra a su lector. -->
    <section class="section section--soft section--slim">
      <div class="container">
        <div class="blog-strip reveal">
          <div class="blog-strip-copy">
            <span class="eyebrow">Desde el blog</span>
            <h2>Decide con datos, no con suposiciones</h2>
            <p>Guías breves sobre precios, SEO local y tecnología, escritas con lo que nos preguntan los clientes.</p>
          </div>
          <ul class="blog-strip-list">
            <% posts.slice(0, 3).forEach(function (post) { %>
              <li>
                <a href="/blog/<%= post.slug %>">
                  <span class="tag"><%= post.category %></span>
                  <strong><%= post.title %></strong>
                  <em><%= post.readTime %></em>
                </a>
              </li>
            <% }) %>
          </ul>
          <a href="/blog" class="btn btn-ghost blog-strip-cta">Ver todos los artículos →</a>
        </div>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <%- include('partials/faq', {
          items: faq.home,
          title: "Lo que más nos preguntan",
          lead: "Respuestas directas a las cuatro dudas que aparecen en casi todas las primeras conversaciones."
        }) %>

    <!-- ================= CTA FINAL ================= -->
    <section class="section">
      <div class="container">
        <div class="cta-band reveal">
          <span class="eyebrow">Empecemos</span>
          <h2>¿Tienes un proyecto en mente?</h2>
          <p>Cuéntanos qué necesitas y te enviamos un presupuesto cerrado en menos de 48 horas. Sin compromiso.</p>
          <div class="cta-actions">
            <a href="/contacto" class="btn btn-primary btn-lg">Pedir presupuesto gratis</a>
            <a href="/proyectos" class="btn btn-ghost btn-lg">Ver nuestro trabajo</a>
          </div>
          <ul class="trust-row">
            <li>Sin compromiso</li>
            <li>Respuesta en 24 h</li>
            <li>Precio cerrado por escrito</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

<%- include('partials/footer') %>
