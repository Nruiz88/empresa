<%- include('partials/head') %>
<%- include('partials/header', { current: "inicio" }) %>

<%# =========================================================
     Shopcito — Portada

     ESTRUCTURA (A/B/C), y el orden importa:

       A. Hero            qué es esto y qué hago
       B. Problema vs.    por qué me tiene que importar
          Solución
       C. Planes          qué compro, cuánto sale

     No hay secciones de servicios, precios comparados,
     contacto, proyectos, blog ni testimonios, y es
     deliberado. En una landing de producto, todo eso es
     ruido: el visitante no llega a leer un texto largo
     buscando precios a ver si lo que vende le sirve. Lo
     que tiene que encontrar, en este orden y sin buscar,
     es qué es, por qué le importa y cuánto sale.

     ── LO QUE SE SACA Y POR QUÉ ──

     · "Proyectos" y "Testimonios": son de estudio digital,
       no de producto. Y los que había eran de ejemplo, con
       nombres inventados y métricas sin fuente (ver
       PENDIENTES.md): dejarlos era publicar cifras falsas.
     · "Servicios": la web anterior vendía diseño web. Esta
       vende un bot. Son cosas distintas y la lista vieja
       decía lo contrario.
     · "Cómo trabajamos": era el idioma de una agencia.
     · Blog: sigue existiendo en /blog y el footer lo enlaza,
       pero no ocupa media portada para alguien que aún no
       entendió qué se le está vendiendo.

     ⚠️  LO QUE FALTA Y HAY QUE PONER ANTES DE PUBLICAR
     ----------------------------------------------------
     · Los tres planes salen SIN precio ("A consultar").
       No hay cifra confirmada. Ver la cabecera de
       `content/shopcito.js`.
     · El CTA de "Probar gratis por 14 días" va a
       `/cuenta/crear`, que es el alta de cuenta de este
       proyecto. Si el alta de prueba no se monta, ese
       botón promete algo que no existe.
     · No hay capturas reales del producto. El hero muestra
       una conversación de ejemplo.
     ========================================================= %>

<main>

  <!-- ================= A. HERO ================= -->
  <section class="hero hero--shopcito" id="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-grid"></div>
      <span class="aurora aurora-1"></span>
      <span class="aurora aurora-2"></span>
      <span class="aurora aurora-3"></span>
      <div class="hero-noise"></div>
    </div>

    <div class="container">
      <div class="hero-layout">
        <!-- ---------- Columna de texto ---------- -->
        <div class="hero-copy">
          <span class="eyebrow eyebrow-pill">
            <span class="dot" aria-hidden="true"></span>
            <%= shopcito.HERO.etiqueta %>
          </span>

          <h1 class="hero-title">
            <%# Una línea por <span>, y la que lleva la palabra
                destacada se envuelve sola para poder darle el
                degradado. La palabra viene DENTRO de la línea,
                no aparte: separarla obligaba a que el título se
                partiera en cinco líneas en celular y a que el
                texto y el resaltado no coincidieran al
                cambiar el copy. %>
            <%# La palabra destacada se busca DENTRO de la línea.

                  Antes se comparaba la línea entera contra el dato, y
                  como el dato es una palabra ("comercio") y la línea
                  es una frase ("para tu comercio"), nunca coincidía y el
                  titular salía entero en azul noche, sin acento.

                  Con esto da igual en qué línea esté: se parte por la
                  palabra y se envuelve solo esa parte. Si la palabra
                  no aparece en ninguna línea —porque alguien cambió el
                  titular y no el dato— no se resalta nada y la página
                  sigue siendo válida; por eso el índice se
                  comprueba. %>
            <% shopcito.HERO.titulo.forEach(function (linea) { %>
              <% var iDestacado = linea.indexOf(shopcito.HERO.destacado); %>
              <span class="line">
                <span>
                  <% if (iDestacado < 0) { %>
                    <%= linea %>
                  <% } else { %>
                    <%= linea.slice(0, iDestacado) %><em class="gradient-text"><%= shopcito.HERO.destacado %></em><%= linea.slice(iDestacado + shopcito.HERO.destacado.length) %>
                  <% } %>
                </span>
              </span>
            <% }); %>
          </h1>

          <p class="lead"><%= shopcito.HERO.subtitulo %></p>

          <div class="hero-actions">
            <a href="<%= shopcito.HERO.cta.href %>" class="btn btn-primary btn-lg magnetic">
              <%= shopcito.HERO.cta.texto %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>

          <p class="hero-note"><span class="dot"></span> <%= shopcito.HERO.ctaNota %></p>

          <!-- Las tres promesas. Sin nota de "clientes" ni
               estrellas: en una landing de producto, un 4,9/5
               con tres avatares inventados es una afirmación
               falsa, y por lo mismo no se pone. -->
          <ul class="promise-row">
            <% shopcito.HERO.promesa.forEach(function (p) { %>
              <li class="promise">
                <span class="promise-icon" aria-hidden="true"><%- include('partials/icono-shop', { nombre: p.icono }) %></span>
                <div>
                  <strong><%= p.texto %></strong>
                  <span class="promise-detalle"><%= p.detalle %></span>
                </div>
              </li>
            <% }); %>
          </ul>
        </div>

        <!-- ---------- Conversación de ejemplo ----------
             Sustituye al mockup de panel de la web anterior.

             Un mockup de "panel de rendimiento" le dice al
             visitante "esto es una web más". Una conversación de
             WhatsApp le dice "esto es lo que va a pasar con mis
             clientes", que es lo que está a la venta.

             Es un ejemplo escrito, no una captura: no hay
             cliente real que pueda mostrarse todavía. -->
        <div class="hero-showcase" data-tilt>
          <div class="wa-window">
            <div class="wa-bar">
              <span class="wa-avatar" aria-hidden="true">T</span>
              <div class="wa-who">
                <strong>Tu comercio</strong>
                <span>en línea</span>
              </div>
            </div>

            <div class="wa-body">
              <p class="wa-time">09:41</p>

              <div class="wa-bubble wa-in">
                <p>Hola! Buenas, tienen turno para mañana?</p>
                <span class="wa-time">09:41</span>
              </div>

              <div class="wa-bubble wa-out">
                <p>¡Hola! Sí 🙌 Tengo dos opciones para mañana:</p>
                <span class="wa-time">09:41</span>
              </div>

              <!-- La tarjeta del producto: es lo que el bot
                   vende y lo que la gente quiere ver. Un texto
                   solo no demuestra que haya una tienda. -->
              <div class="wa-card">
                <span class="wa-card-tag">Catálogo</span>
                <strong>Medialunas x6 · $ 12.000</strong>
                <span class="wa-card-stock">24 disponibles</span>
                <span class="wa-card-btn">Reservar</span>
              </div>

              <div class="wa-bubble wa-out">
                <p>Listo, te lo dejo agendado. Te escribo el detalle 📋</p>
                <span class="wa-time">09:42</span>
              </div>
            </div>

            <div class="wa-input" aria-hidden="true">
              <span>Escribí tu mensaje…</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <a href="#problema" class="scroll-hint" aria-label="Ir a la sección siguiente">
      <span class="scroll-hint-text">Cómo funciona</span>
      <span class="scroll-hint-line"></span>
    </a>
  </section>

  <!-- ================= B. PROBLEMA VS. SOLUCIÓN ================= -->
  <section class="section section--soft" id="problema">
    <div class="container">
      <div class="duelo">

        <!-- ---------- El problema ---------- -->
        <div class="duelo-col duelo-col--mal reveal">
          <span class="eyebrow"><%= shopcito.PROBLEMA.etiqueta %></span>
          <h2><%= shopcito.PROBLEMA.titulo %></h2>
          <p><%= shopcito.PROBLEMA.texto %></p>

          <ul class="duelo-list">
            <% shopcito.PROBLEMA.puntos.forEach(function (p) { %>
              <li>
                <span class="duelo-icon" aria-hidden="true"><%- include('partials/icono-shop', { nombre: p.icono }) %></span>
                <div>
                  <strong><%= p.titulo %></strong>
                  <span><%= p.texto %></span>
                </div>
              </li>
            <% }); %>
          </ul>
        </div>

        <!-- ---------- La solución ----------
             Va a la DERECHA y no debajo a propósito: el ojo va
             de izquierda a derecha, así que el problema se lee
             primero y la solución es lo que se lleva. Puesta
             abajo, la solución es lo segundo que se ve. -->
        <div class="duelo-col duelo-col--bien reveal">
          <span class="eyebrow"><%= shopcito.SOLUCION.etiqueta %></span>
          <h2><%= shopcito.SOLUCION.titulo %></h2>
          <p><%= shopcito.SOLUCION.texto %></p>

          <ol class="pasos-list">
            <% shopcito.SOLUCION.pasos.forEach(function (p) { %>
              <li>
                <span class="paso-num" aria-hidden="true"><%= p.numero %></span>
                <div>
                  <strong><%= p.titulo %></strong>
                  <span><%= p.texto %></span>
                </div>
              </li>
            <% }); %>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= C. PLANES ================= -->
  <section class="section" id="precios">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Planes</span>
        <h2>Empezá chico y crecé cuando <span class="gradient-text">hagas falta</span></h2>
        <p>Los tres planes son mensuales y sin permanencia. El precio te lo decimos cuando nos escribís, y no cambia mientras no lo pidas.</p>
      </div>

      <div class="price-grid">
        <% planes.forEach(function (p) { %>
          <article class="price-card reveal<%= p.destacado ? " featured" : "" %>">
            <% if (p.destacado) { %>
              <span class="badge">Recomendado</span>
            <% } %>

            <h3><%= p.nombre %></h3>
            <p class="plan-desc"><%= p.descripcion %></p>

            <%# ── EL PRECIO ──
                 El formateador vive en `content/precios.js` y
                 no acá. Cuando el plan tenga cifra devuelve el
                 importe y esta caja desaparece sola.

                 `precioDePlan` sale del mismo sitio que los
                 precios viejos a propósito, para que no haya dos
                 reglas distintas para poner un número en pantalla. %>

            <div class="price">
              <span class="amount<%= p.precio ? '' : ' amount--consultar' %>"><%= precioDePlan(p) %></span>
            </div>

            <ul class="price-features">
              <% p.incluye.forEach(function (i) { %><li><%= i %></li><% }); %>
            </ul>

            <p class="price-note"><%= p.nota %></p>

            <a href="<%= p.cta.href %>" class="<%= p.cta.clase %> btn-block"><%= p.cta.texto %></a>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ================= CIERRE ================= -->
  <section class="section section--soft">
    <div class="container">
      <div class="cta-band reveal">
        <h2><%= shopcito.CIERRE.titulo %></h2>
        <p><%= shopcito.CIERRE.texto %></p>
        <div class="cta-actions">
          <a href="<%= shopcito.CIERRE.cta.href %>" class="btn btn-primary btn-lg"><%= shopcito.CIERRE.cta.texto %></a>
        </div>
        <ul class="trust-row">
          <% shopcito.CIERRE.garantias.forEach(function (g) { %><li><%= g %></li><% }); %>
        </ul>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>