<% var _rol = typeof rol !== 'undefined' ? rol : ''; %>
<!DOCTYPE html>
<html lang="es" data-panel>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Shopcito</title>

  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/styles.css" />

  <% modulosDelPanel.forEach(function (hoja) { %>
  <link rel="stylesheet" href="/css/<%= hoja %>" />
  <% }); %>
<link rel="stylesheet" href="/css/aplicaciones.css" />
<link rel="stylesheet" href="/css/plan-apps.css" />
<link rel="stylesheet" href="/css/aplicacion-form.css" />

  <link rel="stylesheet" href="/css/portal.css" />
  <% if (typeof rol !== 'undefined' && rol === 'staff') { %>
  <link rel="stylesheet" href="/css/panel-admin.css" />
  <link rel="stylesheet" href="/css/panel-pro.css" />
  <% } %>

  <script>
    document.documentElement.classList.add("js");
    /* La densidad se aplica ANTES de pintar. Si se hiciera al cargar
       panel.js, la página aparecería cómoda y saltaría a compacta un
       instante después: un parpadeo de densidad que se nota. */
    try {
      if (localStorage.getItem("nexo-densidad") === "compacta") {
        document.documentElement.setAttribute("data-densidad", "compacta");
      }
    } catch (e) {}
  </script>

</head>
<body class="panel-body<%= _rol === 'staff' ? ' panel-body--staff' : ' panel-body--lateral-off' %>">

<% var _nombre = typeof nombre !== 'undefined' ? nombre : ''; %>
<% var _csrf = typeof csrf !== 'undefined' ? csrf : ''; %>

<% var _c = (typeof contadores !== 'undefined' && contadores) ? contadores : { consultas: 0, vencidos: 0, servicios: 0, tickets: 0, botsSinConectar: 0 }; %><% var _current = typeof current !== 'undefined' ? current : ''; %>

<a class="panel-skip" href="#panel-contenido">Saltar al contenido</a>

<% if (_rol === 'staff') { %>
<aside class="panel-side" id="panel-side">
  <div class="panel-side-brand">
    <a href="<%= base %>/" class="panel-brand">

      <span class="brand-mark">
        <img src="/assets/shopcito-logo.jpg" alt="" width="240" height="170" decoding="async" />
      </span>
      <span class="panel-brand-text">
        <strong>Shopcito</strong>
        <small>Panel de equipo</small>
      </span>
    </a>
    <button type="button" class="panel-side-cerrar" data-panel-cerrar aria-label="Cerrar menú">&times;</button>
  </div>

  <%
    /* El menú se pinta desde datos: mismos iconos, rutas, contadores
       y regla de «sección actual» que antes, sin repetir catorce
       bloques casi iguales. Los grupos son <details>: se pliegan sin
       JavaScript y el pequeño script de abajo solo recuerda cuáles
       dejó cerrados la persona. */
    function _pl(n, uno, varios) { return n + ' ' + (n === 1 ? uno : varios); }
    var _I = {
      inicio: '<path d="M3 10.5 10 4l7 6.5M5.5 9v7h9V9"/>',
      clientes: '<circle cx="8" cy="7" r="3"/><path d="M2.5 16c0-3 2.5-4.5 5.5-4.5s5.5 1.5 5.5 4.5M14 5.5a2.5 2.5 0 1 1 0 5"/>',
      servicios: '<path d="M10 3v6l4 2"/><circle cx="10" cy="10" r="7"/>',
      aplicaciones: '<rect x="3" y="3" width="6" height="6" rx="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.5"/><rect x="11" y="11" width="6" height="6" rx="1.5"/>',
      'aplicaciones-catalogo': '<path d="M3 5.5 10 2.5l7 3v9l-7 3-7-3v-9Z"/><path d="M3 5.5 10 8.5l7-3M10 8.5v9"/>',
      catalogo: '<path d="M17.16 11.18l-5.98 5.98a1.67 1.67 0 0 1-2.36 0L1.67 10V1.67h6.66l7.16 7.16a1.67 1.67 0 0 1 0 2.36z"/><circle cx="5.8" cy="5.8" r="1.1"/>',
      planes: '<path d="M10 2.6 2.4 6.4 10 10.2l7.6-3.8z"/><path d="m2.4 13.6 7.6 3.8 7.6-3.8"/><path d="m2.4 10 7.6 3.8L17.6 10"/>',
      bots: '<rect x="4" y="7" width="12" height="9" rx="2.5"/><path d="M10 7V4.6"/><circle cx="10" cy="3.4" r="1.2"/><circle cx="7.6" cy="11" r="1" fill="currentColor" stroke="none"/><circle cx="12.4" cy="11" r="1" fill="currentColor" stroke="none"/><path d="M1.8 10.6v2.4M18.2 10.6v2.4"/>',
      servidores: '<rect x="3" y="4" width="14" height="5" rx="1"/><path d="M5 12.5h10M7 15.5h6"/>',
      consultas: '<rect x="2.5" y="4.5" width="15" height="11" rx="2"/><path d="m3.4 6.2 6.6 4.6 6.6-4.6"/>',
      tickets: '<path d="M3 5h14v10H7l-4 3V5z"/>',
      cobros: '<path d="M10 3v14M13 6.5H8.5a2 2 0 0 0 0 4h3a2 2 0 0 1 0 4H6.5"/>',
      accesos: '<circle cx="7.4" cy="12.6" r="4.2"/><path d="M10.4 9.6 17.4 2.6"/><path d="m14.4 5.6 2 2"/>',
      salud: '<path d="M1 10h4l2.5-6 4 12L14 10h5"/>',
      configuracion: '<circle cx="10" cy="10" r="3"/><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16"/>'
    };
    var _grupos = [
      { id: 'clientes', t: 'Clientes', items: [
        { k: 'clientes', href: '/clientes', txt: 'Clientes' },
        { k: 'servicios', href: '/servicios' + (_c.servicios > 0 ? '?estado=pausado' : ''), txt: 'Servicios',
          badge: { n: _c.servicios, cls: 'pausa', title: _pl(_c.servicios, 'servicio pausado', 'servicios pausados') } }
      ] },
      { id: 'producto', t: 'Producto', items: [
        { k: 'aplicaciones', href: '/aplicaciones', txt: 'Aplicaciones' },
        { k: 'aplicaciones-catalogo', href: '/aplicaciones/catalogo', txt: 'Catálogo de aplicaciones', sub: true },
        { k: 'catalogo', href: '/catalogo', txt: 'Catálogo' },
        { k: 'planes', href: '/planes', txt: 'Planes' }
      ] },
      { id: 'whatsapp', t: 'WhatsApp', items: [
        { k: 'bots', href: '/bots', txt: 'Bots',
          badge: { n: _c.botsSinConectar, cls: 'vencido', title: _c.botsSinConectar + ' bot(s) sin conectar' } },
        { k: 'servidores', href: '/servidores', txt: 'Cajas de bots' }
      ] },
      { id: 'operaciones', t: 'Operaciones', items: [
        { k: 'consultas', href: '/consultas' + (_c.consultas > 0 ? '?estado=nuevo' : ''), txt: 'Consultas',
          badge: { n: _c.consultas, cls: 'nuevo', title: _pl(_c.consultas, 'consulta sin responder', 'consultas sin responder') } },
        { k: 'tickets', href: '/tickets' + (_c.tickets > 0 ? '?estado=abierto' : ''), txt: 'Soporte',
          badge: { n: _c.tickets, cls: 'nuevo', title: _pl(_c.tickets, 'ticket sin resolver', 'tickets sin resolver') } },
        { k: 'cobros', href: '/cobros' + (_c.vencidos > 0 ? '?estado=vencido' : ''), txt: 'Cobros',
          badge: { n: _c.vencidos, cls: 'vencido', title: _pl(_c.vencidos, 'cobro fuera de plazo', 'cobros fuera de plazo') } }
      ] },
      { id: 'sistema', t: 'Sistema', items: [
        { k: 'accesos', href: '/accesos', txt: 'Accesos' },
        { k: 'salud', href: '/salud', txt: 'Salud' },
        { k: 'configuracion', href: '/configuracion', txt: 'Configuración' }
      ] }
    ];
  %>
  <nav class="panel-menu" aria-label="Secciones del panel">
    <a href="<%= base %>/" class="panel-menu-item<%= _current === 'inicio' ? ' is-active' : '' %>"
       <%= _current === 'inicio' ? 'aria-current="page"' : '' %>>
      <svg viewBox="0 0 20 20" aria-hidden="true"><%- _I.inicio %></svg>
      Resumen
    </a>

    <% _grupos.forEach(function (g) { %>
    <details class="panel-grupo" data-grupo="<%= g.id %>" open>
      <summary class="panel-menu-titulo">
        <span><%= g.t %></span>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>
      </summary>
      <div class="panel-grupo-items">
        <% g.items.forEach(function (it) { %>
        <a href="<%= base + it.href %>"
           class="panel-menu-item<%= it.sub ? ' panel-menu-item--hijillo' : '' %><%= _current === it.k ? ' is-active' : '' %>"
           <%= _current === it.k ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 20 20" aria-hidden="true"><%- _I[it.k] %></svg>
          <%= it.txt %>
          <% if (it.badge && it.badge.n > 0) { %>
            <span class="panel-badge panel-badge--<%= it.badge.cls %>"
                  title="<%= it.badge.title %>"><%= it.badge.n > 99 ? "99+" : it.badge.n %></span>
          <% } %>
        </a>
        <% }); %>
      </div>
    </details>
    <% }); %>
  </nav>

  <div class="panel-side-foot">
    <a href="/" target="_blank" rel="noopener">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8 4H4v12h12v-4M12 3h5v5M17 3l-7 7"/></svg>
      Ver la web
    </a>
  </div>

  <script>
    /* Recuerda qué grupos del menú dejó cerrados la persona. Corre
       antes de pintar y nunca cierra el grupo de la sección actual. */
    (function () {
      try {
        var KEY = "nexo-menu-cerrado";
        var cerrados = JSON.parse(localStorage.getItem(KEY) || "[]");
        var grupos = document.querySelectorAll(".panel-grupo");
        grupos.forEach(function (g) {
          if (cerrados.indexOf(g.getAttribute("data-grupo")) > -1 && !g.querySelector(".is-active")) {
            g.removeAttribute("open");
          }
        });
        grupos.forEach(function (g) {
          g.addEventListener("toggle", function () {
            var lista = [];
            grupos.forEach(function (x) { if (!x.open) lista.push(x.getAttribute("data-grupo")); });
            localStorage.setItem(KEY, JSON.stringify(lista));
          });
        });
      } catch (e) {}
    })();
  </script>
</aside>

<div class="panel-shell">
  <header class="panel-topbar">
    <button type="button" class="panel-burger" data-panel-abrir aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <span class="panel-topbar-titulo"><%= title %></span>

    <div class="panel-topbar-acciones">
      <details class="panel-rapido" data-panel-rapido>

        <summary class="panel-btn panel-btn--primary panel-rapido-abrir"
                 aria-label="Nuevo" title="Nuevo">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4.5v11M4.5 10h11"/></svg>
          <span>Nuevo</span>
        </summary>
        <div class="panel-menu-rapido">
          <a href="<%= base %>/clientes/nuevo">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8" cy="7" r="3"/><path d="M2.5 16c0-3 2.5-4.5 5.5-4.5s5.5 1.5 5.5 4.5M14 5.5a2.5 2.5 0 1 1 0 5"/></svg>
            Cliente
          </a>
          <a href="<%= base %>/servicios/nuevo">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v6l4 2"/><circle cx="10" cy="10" r="7"/></svg>
            Servicio
          </a>
          <a href="<%= base %>/cobros/nuevo">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v14M13 6.5H8.5a2 2 0 0 0 0 4h3a2 2 0 0 1 0 4H6.5"/></svg>
            Cobro
          </a>
          <a href="<%= base %>/aplicaciones/nuevo">
            <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="6" height="6" rx="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.5"/><rect x="11" y="11" width="6" height="6" rx="1.5"/></svg>
            Aplicación
          </a>
          <a href="<%= base %>/bots/nuevo">
            <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="4" y="7" width="12" height="9" rx="2.5"/><path d="M10 7V4.6"/><circle cx="10" cy="3.4" r="1.2"/></svg>
            Bot
          </a>
        </div>
      </details>

      <button type="button" class="panel-densidad" data-densidad-toggle
              aria-pressed="false" title="Densidad compacta" aria-label="Cambiar densidad">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14M3 8h14M3 12h14M3 16h14"/></svg>
      </button>

      <%# El usuario y la salida, en la barra de arriba y no en el pie
          del lateral: es donde se busca la cuenta y lo que se usa
          menos que el menú. %>
      <details class="panel-user-menu" data-panel-usuario>
        <summary class="panel-user-menu-btn" aria-label="Cuenta de <%= _nombre || 'equipo' %>">
          <span class="panel-avatar" aria-hidden="true"><%= (_nombre || '?').trim().charAt(0).toUpperCase() %></span>
        </summary>
        <div class="panel-user-menu-lista">
          <div class="panel-user-menu-cabeza">
            <span class="panel-avatar" aria-hidden="true"><%= (_nombre || '?').trim().charAt(0).toUpperCase() %></span>
            <span>
              <strong><%= _nombre || 'Sin nombre' %></strong>
              <small>Equipo</small>
            </span>
          </div>
          <a href="/" target="_blank" rel="noopener">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M8 4H4v12h12v-4M12 3h5v5M17 3l-7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Ver la web
          </a>
          <form method="post" action="<%= base %>/logout">
            <input type="hidden" name="_csrf" value="<%= _csrf %>" />
            <button type="submit" class="panel-btn panel-btn--ghost panel-btn--bloque">Cerrar sesión</button>
          </form>
        </div>
      </details>
    </div>

  </header>

  <main class="panel-main" id="panel-contenido">
<% } else { %>

<div class="panel-shell panel-shell--simple">
  <% if (_nombre) { %>
  <header class="panel-topbar panel-topbar--simple">
    <a href="<%= base %>/" class="panel-brand">

      <span class="brand-mark">
        <img src="/assets/shopcito-logo.jpg" alt="" width="240" height="170" decoding="async" />
      </span>
      <span class="panel-brand-text">
        <strong>Shopcito</strong>
        <small><%= _rol === 'client' ? 'Portal de cliente' : 'Panel' %></small>
      </span>
    </a>

    <% if (_rol === 'client') { %>

      <nav class="panel-nav panel-nav--simple" aria-label="Secciones del portal">
        <a href="<%= base %>/mis-servicios"
           class="<%= current === 'servicios' ? 'is-active' : '' %>"
           title="Mis servicios"
           <%= current === 'servicios' ? 'aria-current="page"' : '' %>>
          <%- icono('bot', { tamano: 16 }) %>
          <span>Servicios</span>
        </a>
        <a href="<%= base %>/servicios-disponibles"
           class="<%= current === 'catalogo' ? 'is-active' : '' %>"
           title="Añadir un servicio"
           <%= current === 'catalogo' ? 'aria-current="page"' : '' %>>
          <%- icono('mas', { tamano: 16 }) %>
          <span>A&ntilde;adir</span>
        </a>

        <a href="<%= base %>/mis-tickets"
           class="<%= current === 'tickets' ? 'is-active' : '' %>"
           title="Mis tickets de soporte"
           <%= current === 'tickets' ? 'aria-current="page"' : '' %>>
          <%- icono('mensaje', { tamano: 16 }) %>
          <span>Ayuda</span>
        </a>
        <a href="<%= base %>/perfil"
           class="<%= current === 'perfil' ? 'is-active' : '' %>"
           title="Mi perfil"
           <%= current === 'perfil' ? 'aria-current="page"' : '' %>>
          <%- icono('negocio', { tamano: 16 }) %>
          <span>Perfil</span>
        </a>
        <a href="<%= base %>/mi-cuenta"
           class="<%= current === 'cuenta' ? 'is-active' : '' %>"
           title="Mi cuenta"
           <%= current === 'cuenta' ? 'aria-current="page"' : '' %>>
          <%- icono('usuario', { tamano: 16 }) %>
          <span>Cuenta</span>
        </a>
      </nav>
    <% } %>

    <div class="panel-user">
      <span class="panel-avatar" aria-hidden="true"><%= (_nombre || '?').trim().charAt(0).toUpperCase() %></span>
      <form method="post" action="<%= base %>/logout">
        <input type="hidden" name="_csrf" value="<%= _csrf %>" />
        <button type="submit" class="panel-btn panel-btn--ghost panel-salir"
                title="Cerrar sesión">
          <%- icono('salir', { tamano: 16 }) %>
          <span>Salir</span>
        </button>
      </form>
    </div>
  </header>
  <% } %>

  <main class="panel-main" id="panel-contenido">
<% } %>
