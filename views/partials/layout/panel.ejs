<%#
  Layout base del panel.

  Sin cabecera ni pie públicos a propósito: el panel es una
  aplicación aparte, no una página más del sitio. Reutiliza el
  CSS y los tokens de marca, pero no sus componentes.

  Bloques:
    { title }      Título de la página
    { noindex }    Siempre true aquí
    { body }       partials/layout/panel-head.ejs y panel-foot.ejs
%>
<!DOCTYPE html>
<html lang="es" data-panel>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Panel Nexo Studio</title>

  <%# El panel nunca debe indexarse %>
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <%_ if (typeof noindex !== 'undefined' && noindex) { _%>
  <meta name="robots" content="noindex, nofollow" />
  <%_ } _%>

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/themes.css" />
  <link rel="stylesheet" href="/css/panel.css" />

  <%# El panel no carga GSAP ni Lenis: no los necesita y son
      ~70 KB que no queremos en la parte privada. %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body class="panel-body">
  <%- body %>
</body>
</html>