<%#
  Bloque de automatización e IA.

  Sin parámetros: lee de content/automation.js.
  Un servicio con status "no" no se publica (ver ese archivo).

  Estructura:
    1. Diagrama de flujo — explica el producto en 4 pasos
    2. Rejilla de servicios con sus entregables
%>
<section class="section automation-section">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">Automatización</span>
      <h2>Que el trabajo empiece <span class="gradient-text">sin que estés</span></h2>
      <p>Conectamos tu web con las herramientas que ya usas para que las consultas se respondan, se filtren y te lleguen listas para trabajar.</p>
    </div>

    <!-- ---------- Flujo ---------- -->
    <ol class="flow reveal">
      <% automation.flujo.forEach(function (f, i) { %>
        <li class="flow-step">
          <span class="flow-icon" aria-hidden="true">
            <% if (f.icon === "chat") { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.9-.9L3 21l1.9-4.9A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z"/></svg>
            <% } else if (f.icon === "bot") { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="3"/><path d="M12 8V4"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg>
            <% } else if (f.icon === "filter") { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v5l-4 2v-7z"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            <% } %>
          </span>
          <span class="flow-num"><%= f.step %></span>
          <h3><%= f.title %></h3>
          <p><%= f.text %></p>
        </li>
      <% }); %>
    </ol>

    <!-- ---------- Servicios ---------- -->
    <div class="auto-grid">
      <% automation.filter(function (s) { return s.status !== "no"; }).forEach(function (s) { %>
        <article class="auto-card reveal<%= s.status === "proximo" ? " auto-card--next" : "" %>">
          <span class="auto-icon" aria-hidden="true">
            <% if (s.icon === "whatsapp") { %>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23a8.19 8.19 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-1.98-1.22 7.42 7.42 0 0 1-1.37-1.71c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31s-.86.84-.86 2.05.88 2.38 1 2.54c.13.16 1.74 2.65 4.2 3.72.59.25 1.05.4 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/></svg>
            <% } else if (s.icon === "brain") { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 3A3.5 3.5 0 0 0 6 6.5 3.5 3.5 0 0 0 4 10a3.5 3.5 0 0 0 1 6.7A3.5 3.5 0 0 0 9.5 20 2.5 2.5 0 0 0 12 17.5V5a2.5 2.5 0 0 0-2.5-2z"/><path d="M14.5 3A3.5 3.5 0 0 1 18 6.5a3.5 3.5 0 0 1 2 3.5 3.5 3.5 0 0 1-1 6.7A3.5 3.5 0 0 1 14.5 20a2.5 2.5 0 0 1-2.5-2.5"/></svg>
            <% } else if (s.icon === "bolt") { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2.5"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>
            <% } %>
          </span>

          <% if (s.status === "proximo") { %>
            <span class="auto-flag">En preparación</span>
          <% } %>

          <h3><%= s.title %></h3>
          <p class="auto-lead"><%= s.lead %></p>

          <ul class="auto-list">
            <% s.items.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>

          <% if (s.note) { %>
            <p class="auto-note"><%= s.note %></p>
          <% } %>
        </article>
      <% }); %>
    </div>

    <div class="automation-cta reveal">
      <p>¿No sabes cuál te viene bien? Cuéntanos cómo recibes hoy las consultas y te decimos por dónde empezar.</p>
      <a href="/contacto?tipo=automatizacion" class="btn btn-primary btn-sm magnetic">Hablar de automatización</a>
    </div>
  </div>
</section>