<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Page metadata -->
  <title><%= typeof title !== 'undefined' ? title : site.name %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : '' %>" />

  <!-- Canonical -->
  <link rel="canonical" href="<%= canonical %>" />

  <!-- Open Graph -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : site.name %>" />
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>" />
  <meta property="og:type" content="<%= ogType || 'website' %>" />
  <meta property="og:url" content="<%= canonical %>" />
  <meta property="og:image" content="<%= site.url + (ogImage || site.ogImage) %>" />
  <meta property="og:image:alt" content="<%= typeof description !== 'undefined' ? description : site.name %>" />
  <meta property="og:site_name" content="<%= site.name %>" />
  <% if (ogType === 'article' && typeof post !== 'undefined' && post) { %>
  <meta property="article:published_time" content="<%= post.dateISO %>" />
  <meta property="article:modified_time" content="<%= post.dateISO %>" />
  <meta property="article:author" content="<%= site.company %>" />
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : site.name %>" />
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>" />
  <meta name="twitter:image" content="<%= site.url + (ogImage || site.ogImage) %>" />
  <% if (site.twitter) { %>
  <meta name="twitter:site" content="<%= site.twitter %>" />
  <% } %>

  <!-- Robots -->
  <meta name="robots" content="<%= noindex ? 'noindex, follow' : 'index, follow' %>" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="apple-touch-icon" href="/assets/favicon.svg" />

  <!-- Fonts

       Outfit entra en lugar de Space Grotesk: es la redondeada que
       pide la marca, y la que mejor va con un producto para comercios.
       "Plus Jakarta Sans" queda como reserva en la pila de
       `--font-display` por si se quiere probar la otra.

       En el `font-family` de la URL van primero las que se usan, y
       quedan las tres iguales en la web y en el panel: los dos
       comparten los tokens de color y también las tipografías, y no
       tiene sentido que los titulares de una pantalla y los de la de
       al lado se vean distintos.

       `display=swap` no es un detalle menor: sin él la página se queda
       sin texto hasta que chegam las fuentes, y en un celular con 4G eso
       son dos segundos de blanco. Con `swap` se ve el texto en la
       tipografía del sistema y se sustituye al llegar. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />

  <!-- CSS -->
  <link rel="stylesheet" href="/css/styles.css" />

  <!-- JSON-LD Structured Data -->
  <!-- Organization -->
  <script type="application/ld+json"><%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": site.name,
    "url": site.url,
    "logo": site.url + site.ogImage,
    "email": site.email,
    "telephone": site.phoneHref,
    "address": site.address,
    "sameAs": [site.linkedin, site.instagram, site.github].filter(Boolean)
  }, null, 0).replace(/</g, '\\u003c') %></script>

  <!-- Article (blog posts) -->
  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
  <script type="application/ld+json"><%- JSON.stringify(structuredData, null, 0).replace(/</g, '\\u003c') %></script>
  <% } %>

  <!-- Breadcrumb -->
  <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length) { %>
  <script type="application/ld+json"><%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map(function (b, i) {
      return {
        "@type": "ListItem",
        "position": i + 1,
        "name": b.name,
        "item": b.url ? site.url + b.url : canonical
      };
    })
  }, null, 0).replace(/</g, '\\u003c') %></script>
  <% } %>

  <!-- FAQ structured data (sólo si la página define preguntas) -->
  <% if (typeof structuredFaq !== 'undefined' && structuredFaq && structuredFaq.length) { %>
  <script type="application/ld+json"><%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": structuredFaq.map(function (f) {
      return {
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      };
    })
  }, null, 0).replace(/</g, '\\u003c') %></script>
  <% } %>

  
<!-- Que hay JavaScript, antes de pintar.

     La clase `js` de arriba es lo que activa el estado inicial
     oculto de los bloques con `.reveal`. Sin esta linea, quien no
     tenga JavaScript se encuentra con la pagina entera en blanco
     menos el hero: el texto, los planes y el cierre estan dentro
     de bloques `.reveal`, que en CSS plano empiezan en opacity 0.

     Va aqui y no al final del body porque tiene que estar puesta
     antes del primer pintado: si se añadiera mas tarde, la pagina
     se pintaria con el contenido visible, se pondria oculta y
     saltaria. Un parpadeo en cada carga. -->
  <script>
    document.documentElement.classList.add("js");
  </script>

</head>
<body>
