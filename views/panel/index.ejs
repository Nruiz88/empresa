<%#
  Resumen del panel.

  Lo primero que ve el equipo al entrar. Tres bloques:
    1. Cifras: consultas sin responder, clientes, servicios vivos.
    2. Caducidades: qué se acaba de verdad y qué toca renovar.
    3. El embudo reciente, para saber si hay algo parado.

  Variables: resumen, caducidades, consultas, aviso
%>
<%- include('../partials/panel-head', { title, site, base, current: 'inicio' }) %>

<div class="panel-page">

  <% if (aviso) { %>
    <div class="panel-alert panel-alert--ok">✓ <%= aviso %></div>
  <% } %>

  <div class="panel-page-head">
    <div>
      <span class="panel-kicker">Resumen</span>
      <h1>Hola, <%= nombre ? nombre.split(' ')[0] : '' %></h1>
    </div>
  </div>

  <%# =========================================================
      QUÉ HACER HOY

      Lo que faltaba en esta pantalla no eran más cifras, era una
      RESPUESTA. La portada tenía tarjetas sueltas y acertabas

      ── POR QUÉ NO ES UNA TABLA MÁS ──

      Porque una tabla de "4 cosas pendientes" obliga a leerlas para
      saber si son urgentes, y aquí el orden ES el mensaje. Lo
      vencido va primero porque es dinero que ya no está; lo demás va
      detrás porque tiene dueño y se está esperando.

      ── POR QUÉ NO HAY CONSULTAS NUEVAS ──

      Cero citas sin contestar, cero tickets sin responder, nada
      pausado, nada por vencer: la pantalla no ensucia con un bloque
      vacío ni con un "0" en cada sitio. Un cero repetido cuatro
      veces enseña a ignorar los números, y el día que haya 4.000
      vencidos ese rojo ya no significa nada.

      ── DE DÓNDE SALE, Y POR QUÉ NO CUESTA NADA ──

      De `contadores`, que el middleware de `routes/panel.js` ya
      calcula en CADA página del panel para los badges del lateral:
      consultas, vencidos, servicios y tickets, en paralelo y con
      `head: true`.

      Aquí se reutiliza ese trabajo en vez de hacer una consulta
      nueva. Una portada que cuenta lo mismo dos veces no es un
      dato mejor, es una espera más.
        ========================================================= %>
  <%
    var _c = (typeof contadores !== 'undefined' && contadores) ? contadores : {};

    var _pendientes = [];
      /* ── LOS VENCIMIENTOS: UNA FILA POR SERVICIO ──

         Antes se agrupaban por TEXTO: todos los "caduca en 7 dias"
         que caen en una sola fila que decía "caducó hace 38 días"
         y llevaba a /servicios?estado=activo, o sea a un listado
         de cinco servicios sin ninguno resaltado.

         Era el peor sitio posible para perder contexto. Un bloque
         titulado "qué hay que hacer" que dice "caducó hace 38 días"
         sin decir DE QUE, y cuyo enlace obliga a buscar cuál
         de los cinco, no es una respuesta: es la pregunta otra
         vez.

         Ahora cada fila es un servicio, con su empresa, su título y
         su enlace a SU ficha. Los avisos de un mismo servicio se
         juntan; los de servicios distintos no. */
      var _porServicio = {};
      (caducidades || []).forEach(function (x) {
        if (!x.id) return;
        var k = x.id;
        if (!_porServicio[k]) {
          _porServicio[k] = { nivel: x.nivel, titulo: x.titulo, empresa: x.empresa, id: x.id, dias: x.dias, avisos: [] };
        }
        _porServicio[k].avisos.push(x.texto);
        /* Gana el mas urgente el color, que es el que explica por
           que sale. Un servicio puede tener a la vez un cobro
           caducado y una renovacion en dos semanas. */
        if (x.dias !== null && (_porServicio[k].dias === null || x.dias < _porServicio[k].dias)) {
          _porServicio[k].nivel = x.nivel;
          _porServicio[k].dias = x.dias;
        }
      });

      /* El color sale del NIVEL de urgencia, que lib/vencimientos.js
         ya calcula: vencido, urgente, aviso, tranquilo, pendiente.

         La primera version los ponia TODOS en ambar, con lo que un
         servicio caducado hace 38 dias salia del mismo color que
         uno que se renueva dentro de tres semanas. Y en una lista
         ordenada por urgencia, que dos cosas distintas compartan
         color es peor que no ordenarlas: da a entender que
         igualan cuando no igualan. */
      var _COLOR = { vencido: "rojo", urgente: "rojo", aviso: "ambar", pendiente: "ambar" };

      /* "tranquilo" no sale. Una renovacion a dentro de dos meses
         no es nada que hacer hoy, y meterla aqui haria que el
         bloque creciera con cosas que no urgen. Para eso esta el
         bloque de "Vencimientos y renovaciones", mas abajo, que si
         las enseña. */
      var _caducos = Object.keys(_porServicio)
        .map(function (k) { return _porServicio[k]; })
        .filter(function (g) { return _COLOR[g.nivel]; })
        /* Y se ordenan por dias: lo mas vencido primero. */
        .sort(function (a, b) { return (a.dias === null ? 1e9 : a.dias) - (b.dias === null ? 1e9 : b.dias); });
      if (_c.vencidos > 0) {
        _pendientes.push({ nivel: "rojo", n: _c.vencidos, texto: "cobro" + (_c.vencidos === 1 ? "" : "s") + " fuera de plazo", href: base + "/cobros?estado=vencido", accion: "Ver" });
      }
    if (_c.consultas > 0) {
      _pendientes.push({ nivel: "cian", n: _c.consultas, texto: "consulta" + (_c.consultas === 1 ? "" : "s") + " sin responder", href: base + "/consultas?estado=nuevo", accion: "Responder" });
    }
    if (_c.tickets > 0) {
      _pendientes.push({ nivel: "cian", n: _c.tickets, texto: "ticket" + (_c.tickets === 1 ? "" : "s") + " sin resolver", href: base + "/tickets?estado=abierto", accion: "Atender" });
    }
    if (_c.servicios > 0) {
      _pendientes.push({ nivel: "ambar", n: _c.servicios, texto: "servicio" + (_c.servicios === 1 ? "" : "s") + " en pausa", href: base + "/servicios?estado=pausado", accion: "Revisar" });
    }
    _caducos.forEach(function (g) {
      _pendientes.push({
        nivel: _COLOR[g.nivel],
        n: 1,
        texto: (g.empresa ? g.empresa + " · " : "") + (g.titulo || "servicio"),
        pista: g.avisos.join(" · "),
        href: base + "/servicios/" + g.id + "/editar",
        accion: "Abrir"
      });
    });

    /* ── Y POR ÚLTIMO SE ORDENA ──

       Los pushes de arriba agrupan por ORIGEN (dinero, consultas,
       tickets, servicios, vencimientos), no por urgencia. Y esa
       diferencia se notaba: un servicio caducado hace 38 días, que
       es rojo, salía debajo de un "servicio en pausa", que es
       ámbar, porque se había añadido después.


       Es decir: la lista se leía en el orden en que se construía y
       no en el que importa. Y en un bloque que se titula "qué hay
       que hacer", el orden no es decorativo: es la respuesta.

       El Array.sort de Node es estable, así que dentro de un mismo
       color se respeta el orden de inserción — que para los
       vencimientos ya viene ordenado por días, de más vencido a
       menos. Por eso el cobro rojo sigue arriba: no porque se
       clasifique aparte, sino porque se añadió primero. */
    var _RANGO = { rojo: 0, cian: 1, ambar: 2 };
    _pendientes.sort(function (a, b) { return _RANGO[a.nivel] - _RANGO[b.nivel]; });
  %>

  <section class="panel-hacer">
    <h2 class="panel-hacer-titulo">
      <% if (_pendientes.length) { %>Qué hay que hacer<% } else { %>Nada pendiente<% } %>
    </h2>

    <% if (!_pendientes.length) { %>
      <p class="panel-hacer-vacio">
        No hay cobros vencidos, ni consultas sin responder, ni tickets
        sin resolver, ni servicios en pausa.
        <span class="panel-hacer-vacio-nota">Si algo cambia, aparecerá aquí.</span>
      </p>
    <% } else { %>
      <ul class="panel-hacer-lista">
        <% _pendientes.forEach(function (p) { %>
          <li class="panel-hacer-item panel-hacer-item--<%= p.nivel %>">
            <span class="panel-hacer-n" aria-hidden="true"><%= p.n > 99 ? "99+" : p.n %></span>
            <a href="<%= p.href %>" class="panel-hacer-texto">
              <span class="panel-hacer-linea"><strong><%= p.texto %></strong></span>
              <% if (p.pista) { %>
                <span class="panel-hacer-pista"><%= p.pista %></span>
              <% } %>
            </a>
            <a href="<%= p.href %>" class="panel-btn panel-btn--ghost panel-btn--xs"><%= p.accion %></a>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <% if (!resumen) { %>
    <div class="panel-alert">
      No se pudo leer la base de datos. Revisa que Supabase esté bien
      configurado en <code>.env</code>.
    </div>
  <% } else { %>

    <!-- ---------- Cifras ---------- -->
      <!-- ---------- El dinero, primero ----------
           El orden importa, y el motivo esta en la ruta.

           Antes eran tres tarjetas iguales: consultas, clientes y
           servicios. Las tres en violeta, del mismo tamano, en el
           mismo sitio. Una consulta sin responder --una alerta-- se
           veia igual que dieciocho clientes, que es un dato.

           Y faltaba lo unico que no tiene arreglo tecnico: lo que se
           debe. Aqui hay 2.400 EUR vencidos y la portada no lo decia.
           El dinero va primero y en su color: lo vencido en rojo, lo
           que esta en plazo en ambar. Si hay que mirar una sola cifra
           al entrar, es esa.

           Un detalle que parece raro y no lo es: si no hay nada
           vencido, la tarjeta roja no se enseña. Un 0 en rojo es
           ruido que entrena a ignorar el color, y el dia que haya
           2.400 el rojo ya no significa nada. -->
      <% if (dineroPortada && dineroPortada.hay) { %>
        <div class="panel-stats">
          <% dineroPortada.cuentas.forEach(function (c) { %>

            <% if (c.nVencidos > 0) { %>
              <a class="panel-stat panel-stat--alerta" href="<%= base %>/cobros?estado=vencido">
                <strong><%= c.textoVencidos %></strong>
                <span><%= c.nVencidos %> cobro<%= c.nVencidos === 1 ? "" : "s" %> vencido<%= c.nVencidos === 1 ? "" : "s" %></span>
              </a>
            <% } %>

            <a class="panel-stat panel-stat--ambar" href="<%= base %>/cobros?estado=pendiente">
              <strong><%= c.texto %></strong>
              <span><%= c.n %> por cobrar<%= c.moneda !== "EUR" ? " · " + c.moneda : "" %></span>
            </a>
          <% }); %>
        </div>
      <% } %>

      <!-- ---------- Cifras de gente ----------
           Debajo del dinero, y neutras. Son datos, no alarmas: que se
           vean como datos. -->
    <div class="panel-stats">
      <a class="panel-stat" href="<%= base %>/consultas?estado=nuevo">
        <strong><%= resumen.consultasNuevas %></strong>
        <span>consultas sin responder</span>
      </a>
      <a class="panel-stat" href="<%= base %>/clientes">
        <strong><%= resumen.clientes %></strong>
        <span>clientes activos</span>
      </a>
      <a class="panel-stat" href="<%= base %>/servicios?estado=activo">
        <strong><%= resumen.serviciosActivos %></strong>
        <span>servicios en marcha</span>
      </a>
    </div>

    <!-- ---------- Caducidades ----------
         Los avisos se agrupan cuando comparten el mismo texto. Tres
         filas diciendo "renovación pendiente · se renueva 2 nov" no
         informan de nada: lo que hay que ver es cuántas son. -->
    <% var grupos = {}; %>
    <% (caducidades || []).forEach(function (c) {
         var clave = c.nivel + '|' + c.texto;
         if (!grupos[clave]) grupos[clave] = { nivel: c.nivel, texto: c.texto, items: [] };
         grupos[clave].items.push(c);
       }); %>
    <% var listaGrupos = Object.keys(grupos).map(function (k) { return grupos[k]; }); %>

    <section class="panel-bloque">
      <div class="panel-bloque-head">
        <h2 class="panel-subtitle">Vencimientos y renovaciones</h2>
        <a href="<%= base %>/servicios?estado=activo" class="panel-clear">Ver servicios</a>
      </div>

      <% if (!listaGrupos.length) { %>
        <p class="panel-hint">
          Ningún servicio con fecha de fin. Cuando asignes
          <code>termina_en</code> a un mantenimiento, aquí aparecerá
          días antes de que caduque.
        </p>
      <% } else { %>
        <ul class="panel-caducos">
          <% listaGrupos.forEach(function (g) { %>
            <li class="panel-caduco panel-caduco--<%= g.nivel %>">
              <div class="panel-caduco-main">
                <strong>
                  <% if (g.items.length === 1) { %>
                    <%= g.items[0].titulo %>
                  <% } else { %>
                    <%= g.items.length %> servicios
                  <% } %>
                </strong>

                <%# Las empresas van como etiquetas sueltas, no como un
                    párrafo con puntos: si no, tres nombres en una
                    línea se parten en tres renglones y no se leen. %>
                <% if (g.items.length === 1) { %>
                  <span class="panel-caduco-empresa"><%= g.items[0].empresa %></span>
                <% } else { %>
                  <span class="panel-caduco-empresas">
                    <% g.items.forEach(function (i) { %>
                      <span class="panel-tag-soft"><%= i.empresa %></span>
                    <% }); %>
                  </span>
                <% } %>
              </div>

              <div class="panel-caduco-side">
                <% var suma = g.items.reduce(function (t, i) {
                     return t + (Number(i.importe) || 0);
                   }, 0); %>
                <% if (suma > 0) { %>
                  <span class="panel-serv-price"><%= dinero(suma, 'EUR') %></span>
                <% } %>
                <% if (g.texto) { %>
                  <span class="panel-caduco-cuando"><%= g.texto %></span>
                <% } %>
              </div>

              <%# Con un solo servicio se va a él. Con varios, el
                  destino útil es el listado filtrado: tres botones
                  "Revisar" que apuntan a tres sitios distintos solo
                  hacen tres filas más largas. %>
              <% if (g.items.length === 1) { %>
                <a href="<%= base %>/servicios/<%= g.items[0].id %>/editar"
                   class="panel-btn panel-btn--ghost panel-btn--xs">Revisar</a>
              <% } else { %>
                <a href="<%= base %>/servicios?estado=<%= g.items[0].estado %>"
                   class="panel-btn panel-btn--ghost panel-btn--xs">Ver los <%= g.items.length %></a>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <!-- ---------- Embudo ---------- -->
    <% if (consultas && consultas.length) { %>
      <section class="panel-bloque">
        <h2 class="panel-subtitle">Consultas recientes</h2>
        <ul class="panel-list">
          <% consultas.forEach(function (c) { %>
            <li>
              <strong><%= c.nombre %><% if (c.empresa) { %> · <%= c.empresa %><% } %></strong>
              <span><%= c.cuando %> · <%= etiquetaLead(c.estado) %></span>
            </li>
          <% }); %>
        </ul>
        <p class="panel-hint" style="margin-top:.75rem">
          <a href="<%= base %>/consultas">Ver todas las consultas</a>
        </p>
      </section>
    <% } %>

  <% } %>
</div>

<%- include('../partials/panel-foot', { site }) %>
