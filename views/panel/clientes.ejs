<%#
  Listado de clientes con búsqueda y paginación.

  Variables: clientes, q, pagina, paginas, total, desde, hasta
%>
<%- include('../partials/panel-head', { title, site, base, current }) %>

<div class="panel-page">
  <div class="panel-page-head">
    <div>
      <span class="panel-kicker">Gestión</span>
      <h1>Clientes</h1>
      <p class="panel-count"><%= total %> cliente<%= total === 1 ? '' : 's' %></p>
    </div>
    <a href="<%= base %>/clientes/nuevo" class="panel-btn panel-btn--primary">Nuevo cliente</a>
  </div>

  <!-- Filtros -->
  <form class="panel-filters" method="get" action="<%= base %>/clientes">
    <input type="search" name="q" value="<%= q %>" placeholder="Buscar por nombre, empresa o email…" class="panel-search" />
    <% if (q) { %><a href="<%= base %>/clientes" class="panel-btn panel-btn--ghost panel-btn--xs">Limpiar</a><% } %>
  </form>

  <% if (!clientes.length) { %>
    <div class="panel-empty">
      <% if (q) { %>
        <h2>Nada con «<%= q %>»</h2>
        <p>Prueba con otro término, o revisa si el cliente está archivado.</p>
        <a href="<%= base %>/clientes" class="panel-btn panel-btn--ghost">Ver todos</a>
      <% } else { %>
        <h2>Todavía no hay clientes</h2>
        <p>Da de alta el primero y podrás colgarle sus servicios.</p>
        <a href="<%= base %>/clientes/nuevo" class="panel-btn panel-btn--primary">Nuevo cliente</a>
      <% } %>
    </div>
  <% } else { %>

    <div class="panel-table-wrap">
      <table class="panel-table panel-table--clientes">
        <thead>
          <tr>
            <th>Empresa</th>
            <th>Contacto</th>
            <th class="panel-th-email">Email</th>
            <th class="panel-th-actions"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          <% clientes.forEach(function (c) { %>
            <!--
              `data-label` en cada celda, y `data-principal` en la
              primera.

              En pantallas anchas no se ven: el estilo no hace nada con
              ellas. Por debajo de 720px la tabla deja de ser tabla y
              cada fila se convierte en una tarjeta, y entonces sí
              hacen falta: sin la etiqueta, una celda suelta es
              «+34 600 333 444» sin decir de qué. Con la tabla
              original, cada dato iba en su columna y se entendía;
              al apilar, esa información se pierde y hay que
              devolverla.

              `data-principal` dice qué celda es el nombre. En la
              tarjeta va sola arriba, sin etiqueta, porque el nombre
              ya se explica solo y "Empresa: Panadería La Espiga" es
              más ruido que información.

              El enlace del nombre lleva `panel-stretch`: con él, toda
              la fila es pulsable sin que el <a> tenga que envolver a
              la fila entera —que no valdría, porque dentro hay otro
              <a> de email—. Ver `.panel-stretch` en panel.css.
            -->
            <tr class="panel-row--link">
              <td data-principal>
                <a href="<%= base %>/clientes/<%= c.id %>" class="panel-cell-main panel-stretch">
                  <%= c.empresa || c.nombre %>
                </a>
                <% if (c.empresa && c.nombre !== c.empresa) { %>
                  <span class="panel-cell-sub"><%= c.nombre %></span>
                <% } %>
                <% if (c.archivado) { %><span class="panel-chip panel-chip--mute">Archivado</span><% } %>
              </td>
              <td data-label="Contacto"><%= c.telefono || "—" %></td>
              <td data-label="Email" class="panel-th-email">
                <% if (c.email) { %>
                  <a href="mailto:<%= c.email %>"><%= c.email %></a>
                <% } else { %>—<% } %>
              </td>
              <td class="panel-th-actions">
                <!-- Solo se ve en la tarjeta (celular). En escritorio la
                     fila entera se abre con el enlace del nombre, y
                     dieciocho botones "Abrir" iguales compiten entre sí
                     por la atención. En la tarjeta el botón sí hace
                     falta: la fila es más alta que el ancho y no hay
                     forma de saber que es pulsable.
                     El `.sr-only` de dentro no es decorativo: sin él un
                     lector de pantalla oye dieciocho "Abrir" y no sabe
                     a qué cliente abre cada uno. -->
                <a href="<%= base %>/clientes/<%= c.id %>" class="panel-btn panel-btn--ghost">
                  Abrir
                  <span class="sr-only"><%= c.empresa || c.nombre %></span>
                </a>
                <span class="panel-chevron" aria-hidden="true"></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (paginas > 1) { %>
      <nav class="panel-pager" aria-label="Paginación">
        <% if (pagina > 1) { %>
          <a href="?pagina=<%= pagina - 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">← Anterior</a>
        <% } %>
        <span>Página <%= pagina %> de <%= paginas %> · viendo <%= desde %>–<%= hasta %></span>
        <% if (pagina < paginas) { %>
          <a href="?pagina=<%= pagina + 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">Siguiente →</a>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</div>

<%- include('../partials/panel-foot', { site }) %>
