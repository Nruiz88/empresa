# =====================================================================
# Copia este archivo como ".env" y rellena los valores.
# NO subas el .env a git (ya está en .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# CONEXIÓN A LA BASE DE DATOS
# ---------------------------------------------------------------------
# Usa el POOLER DE SESIÓN, no la conexión directa.
#
# Motivo: la conexión directa a Supabase solo resuelve por IPv6 y falla
# en redes IPv4. El pooler funciona por ambos.
#
# Dónde encontrarlo:
#   Supabase > Settings > Database > Connection string
#   -> Deployment type: Session pooler  (NO "Direct connection")
#
# Formato esperado:
#   postgresql://postgres.ABCD1234:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
DATABASE_URL=

# ---------------------------------------------------------------------
# AUTENTICACIÓN (Supabase Auth)
# ---------------------------------------------------------------------
# Las dos están en: Supabase > Settings > API
#
# OJO con el nombre: el código pide SUPABASE_PUBLISHABLE_KEY.
# Supabase llama "publishable" a lo que antes era "anon", y no es lo
# mismo: la clave anon antigua ya no sirve para pasar de RLS.
# Si copias el nombre de aquí tal cual, `npm run estado` avisa.

# Clave publicable. Va también en el navegador y NO es un secreto:
# la seguridad la garantizan las políticas RLS de la base de datos.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta. OMITIR en el navegador: se salta RLS.
# Si esta clave se filtra, alguien puede leer y escribir TODO.
# Solo en el servidor, y en .env.
#
# ⚠️  Si alguna vez la has pegado en un chat, en un commit o en un
#     pantallazo: rótala en Settings > API. Borrarla del historial
#     no sirve, sigue ahí.
SUPABASE_SECRET_KEY=

# URL del proyecto. Es pública: también va en el navegador.
SUPABASE_URL=

# ---------------------------------------------------------------------
# SITIO
# ---------------------------------------------------------------------
# Secretos para firmar cookies de sesión (mínimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Firma de los tickets de acceso entre servicios (migración 008,
# lib/tickets.js). Tiene que ser DISTINTO de SESSION_SECRET: si
# comparten valor, una firma válida del panel valdría como cookie de
# sesión y se podría saltar el login.
#
# Solo hace falta cuando haya microservicios (bot, inventario). En
# el monolito no se usa, pero declara aquí desde ya para no tener que
# tocarlo el día que aparezca.
SERVICE_SECRET=

# Entorno. En producción tiene que ser "production"
# (activa cookies Secure y no muestra los avisos de desarrollo).
NODE_ENV=development

# URL pública del sitio. Se usa en emails, redirecciones y el sitemap.
#
# En producción: https://tucormercio.com.ar
#
# ⚠️  DE AQUÍ SALEN DOS COSAS MÁS, Y NO SON OBLIGATORIAS DE PENSARLAS:
#
#   · el subdominio del PANEL, si no le pones PANEL_URL
#   · la URL del WEBHOOK del bot (bot.tucormercio.com.ar/api/webhook),
#     que es la dirección que el panel le da a cada Evolution
#
# Las dos se pueden pisar a mano (PANEL_URL, BOT_URL) y, en el caso del
# webhook, por caja desde /panel/servidores. Lo que NO se puede es que
# queden mal: una Evolution a la que se le manda a un sitio donde no hay
# nadie responde 200 igual, y el bot queda mudo sin dar ningún error.
#
# En desarrollo déjalo en 127.0.0.1: el panel avisa y el webhook apunta al
# bot local por el puerto.
SITE_URL=http://127.0.0.1:3000

# URL del PANEL, que va en subdominio aparte.
#
# Por qué subdominio y no /panel: la cookie de sesión es host-only,
# así que con el panel en panel.midominio.com un XSS en la web pública
# NO puede leer la sesión del panel. En el mismo host, sí podría.
#
# Es un marcador: cuando elijas el dominio, cambia aquí y en
# lib/site.js (donde está el valor por defecto). Con el protocolo
# delante; si no lo pones, se asume https salvo en localhost.
# En producción: https://panel.tucormercio.com.ar
PANEL_URL=https://panel.tucormercio.com.ar

# Puerto del panel. Solo lo usa panel.js (proceso separado).
PORT=3100

# Interfaz en la que escucha panel.js.
# Vacío = todas las interfaces (lo normal en desarrollo).
# En producción conviene acotarlo: 127.0.0.1 detrás de un reverse
# proxy, o la IP del servicio. El panel tiene datos de clientes y no
# hace falta que quede accesible desde la red en la que vive.
#PANEL_HOST=127.0.0.1

# ---------------------------------------------------------------------
# El bot de WhatsApp (proceso aparte: npm run start:bot)
# ---------------------------------------------------------------------
# Puerto del bot. El panel usa 3100, así que este tiene que ser otro.
#BOT_PORT=3200

# Interfaz en la que escucha bot.js. Mismo criterio que PANEL_HOST:
# en producción, 127.0.0.1 detrás del reverse proxy.
# OJO: el bot habla con clientes (tiene conversaciones y citas), así
# que acotarlo no es opcional en cuanto salga a internet.
#BOT_HOST=127.0.0.1

# Secreto del webhook de entrada. OBLIGATORIO en el servicio del bot.
#
# Sin esto el webhook NO ACEPTA NADA y devuelve 503, a propósito: la
# ruta es pública (la llama Evolution desde fuera) y sin un secreto
# cualquiera podría mandar un WhatsApp desde el número del negocio a
# quien quiera. Fallar cerrado es la opción; fallar abierto
# "porque en desarrollo no hace falta" es como se rompe esto.
#
# ⚠️  ESTE YA NO LO USA EL PANEL. La cabecera `x-webhook-secret` que
#     Evolution manda la pone el PANEL, no este fichero: al dar de alta
#     un bot lee el secreto de la caja (`evolution_servers.
#     webhook_secret`, migración 021) y se lo dice a la Evolution con
#     `POST /webhook/set`. Si el valor viviera solo aquí, el panel
#     configuraría la caja con un secreto que el bot no comparte y
#     todos los bots quedarían mudos sin dar ningún error.
#
#     Para ponerlo en una caja: `npm run secreto:webhook` (lee el
#     WEBHOOK_SECRET del bot y lo guarda en la caja que coincida por
#     url). Desde la pantalla, en /panel/servidores → Editar.
#
#     Los dos valores TIENEN que ser iguales: el del bot (este) y el de
#     la caja. Si no coinciden, la Evolution acepta los mensajes y el
#     bot los rechaza al llegar.
#BOT_WEBHOOK_SECRET=
#
# (OJO: el panel NO lee esta variable. El secreto que le manda a la
#  Evolution sale de cada caja, en evolution_servers.webhook_secret. Esta
#  es la copia que tiene el servicio del bot, y las dos tienen que
#  coincidir. Ver el bloque de arriba.)

# URL PÚBLICA del bot. OJO: no es su interfaz de escucha (eso es
# BOT_HOST), es la dirección por la que se llega desde fuera, que es
# la que va en el botón "Abrir" del portal del cliente.
#
# Normally NO hay que ponerla: si está vacía, el bot va a
# bot.<tu-dominio>, deducido de SITE_URL. O sea, se cambia SITE_URL
# una vez y todo lo demás se mueve solo.
#
# Solo rellénala si el bot NO vive en el subdominio del dominio
# principal: un proveedor externo, o un dominio aparte entero. Con
# https://api.ejemplo.com gana esta sobre la deducida.
#BOT_URL=

# ---------------------------------------------------------------------
# ZONA HORARIA
# ---------------------------------------------------------------------
# No la pongas aquí. Se configura en el SERVIDOR (TZ en el systemd
# unit, TZ en Docker, o el panel del hosting), y en Windows con la
# configuración regional del sistema.
#
# Está en esta lista solo porque db/test-fechas.js la fija al correr
# pruebas, y `npm run estado` avisa de las claves que el código toca
# sin declarar. No hace falta declararla.
#
# Por qué importa tanto: todas las fechas del panel (vencimientos,
# plazos de pago, avisos) se calculan en hora LOCAL. Con la zona mal
# puesta, los vencimientos caen un día antes y alguien pierde el
# acceso de su panel el día que le toca pagar.

# ---------------------------------------------------------------------
# EMAIL (lo usaremos en el portal de clientes)
# ---------------------------------------------------------------------
# Vacío = modo desarrollo: los emails se registran en consola
# en vez de enviarse. Es lo más cómodo hasta que tengas el proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nexo Studio <hola@tu-dominio.com>"
