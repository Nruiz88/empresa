{
  "name": "nexo-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Web de Nexo Studio — sitio corporativo en Node.js (Express + EJS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:bot": "node bot.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrate.js",
    "migrate:status": "node db/migrate.js --estado",
    "verify": "node db/verify.js",
    "check": "node db/check.js",
    "restart": "node db/restart.js",
    "stop": "node db/restart.js --stop",
    "captura": "node db/captura.js",
    "captura:cliente": "node db/captura-cliente.js",
    "escenario": "node db/escenario-cliente.js --vencido",
    "sonda": "node db/captura.js /panel && node db/sonda-anchura.js",
    "log": "node -e \"console.log(require('fs').readFileSync('logs/error.log','utf8').split('\\\\n').slice(-40).join('\\\\n'))\"",
    "rls": "node db/rls.js",
    "estado": "node db/estado.js",
    "test": "node db/check.js && node db/rls.js && node db/test-fechas.js && node db/test-env.js && node db/test-idempotencia.js && node db/test-vencimientos.js && node db/test-acceso.js && node db/test-cobros-mensuales.js && node db/test-modulos.js && node db/test-perfil.js && node db/test-tickets.js && node db/test-bot.js && node db/test-ejecutar-sql.js && node db/test-isolation.js",
    "test:panel": "node db/test-panel.js && node db/test-cobros.js && node db/test-panel-html.js && node db/test-generar-cobros.js && node db/test-mi-cuenta.js && node db/test-acceso-servicio.js",
    "test:aislamiento": "node db/test-isolation.js",
    "test:vencimientos": "node db/test-vencimientos.js",
    "test:fechas": "node db/test-fechas.js",
    "test:env": "node db/test-env.js",
    "test:dominios": "node db/test-dominios.js",
    "test:bot:vuelta": "node db/test-vuelta-bot.js",
    "test:cobros": "node db/test-cobros-mensuales.js",
    "test:acceso": "node db/test-acceso.js",
    "test:modulos": "node db/test-modulos.js",
    "test:bot": "node db/test-bot.js",
    "limpiar:pruebas": "node db/limpiar-pruebas.js",
    "demo:portal": "node db/demo-portal.js",
    "demo:portal:limpiar": "node db/demo-portal.js --limpiar",
    "seed": "node db/seed.js",
    "seed:limpiar": "node db/seed.js --limpiar",
    "usuario": "node db/create-user.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
